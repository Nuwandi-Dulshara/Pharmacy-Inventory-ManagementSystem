<UserControl x:Class="MediStock.Desktop.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Reports" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="Generate date-filtered sales, stock, expiry, and supplier reports. Exports use the active filters."
                       Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,12" />
            <Border Background="{DynamicResource SurfaceBrush}" Padding="12" Margin="0,0,0,12"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                <StackPanel Orientation="Horizontal">
                    <ComboBox x:Name="ReportTypeBox" Width="155" SelectedIndex="0">
                        <ComboBoxItem Content="Sales" /><ComboBoxItem Content="Stock" />
                        <ComboBoxItem Content="Expiry" /><ComboBoxItem Content="Supplier" />
                    </ComboBox>
                    <TextBlock Text="From" VerticalAlignment="Center" Margin="0,0,6,8" />
                    <DatePicker x:Name="FromPicker" Width="145" />
                    <TextBlock Text="To" VerticalAlignment="Center" Margin="8,0,6,8" />
                    <DatePicker x:Name="ToPicker" Width="145" />
                    <Button Content="Generate" Click="Generate_Click" />
                    <Button Content="Export CSV" Click="ExportCsv_Click"
                            Background="{DynamicResource AccentLightBrush}" Foreground="{DynamicResource TextBrush}" />
                    <Button Content="Export PDF" Click="ExportPdf_Click" />
                </StackPanel>
            </Border>
        </StackPanel>
        <DataGrid x:Name="ReportGrid" Grid.Row="1" AutoGenerateColumns="True" />
        <TextBlock x:Name="StatusText" Grid.Row="2" Margin="0,12,0,0" TextWrapping="Wrap" />
    </Grid>
</UserControl>
