<UserControl Tag="Predictions" x:Class="MediStock.Desktop.Views.PredictionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Demand prediction" Style="{StaticResource PageHeadingStyle}" />
            <TextBlock Text="Forecasts are based on historical daily sales."
                       Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,12" />
            <WrapPanel>
                <ComboBox x:Name="MedicineBox" Width="390" DisplayMemberPath="Display" />
                <ComboBox x:Name="DaysBox" Width="130" SelectedIndex="0">
                    <ComboBoxItem Content="7 days" Tag="7" />
                    <ComboBoxItem Content="30 days" Tag="30" />
                </ComboBox>
                <Button x:Name="PredictButton" Content="Predict demand" Click="Predict_Click" />
            </WrapPanel>
            <TextBlock x:Name="SummaryText" TextWrapping="Wrap" Margin="0,4,0,12" FontSize="15" />
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10">
            <Image x:Name="ForecastChart" Stretch="Uniform" MinHeight="180"
                   Visibility="Collapsed" />
        </Border>
        <DataGrid x:Name="ForecastGrid" Grid.Row="2" MinHeight="120">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Forecast date" Binding="{Binding Date, StringFormat=d}" Width="*" />
                <DataGridTextColumn Header="Estimated units" Binding="{Binding Units, StringFormat=N1}" Width="180" />
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock Grid.Row="3" Text="Available stock excludes expired batches."
                   Foreground="{DynamicResource MutedBrush}" Margin="0,12,0,0" TextWrapping="Wrap" />
    </Grid>
</UserControl>
