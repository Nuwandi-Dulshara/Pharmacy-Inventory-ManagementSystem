<UserControl Tag="Invoices" x:Class="MediStock.Desktop.Views.InvoicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="2*" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Invoices" Style="{StaticResource PageHeadingStyle}" />
            <TextBlock Text="Search completed sales by invoice number or date." Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,12" />
            <WrapPanel>
                <TextBox x:Name="SearchBox" Width="280" ToolTip="Invoice number" />
                <DatePicker x:Name="FromDatePicker" Width="150" Margin="8,3,0,10" />
                <DatePicker x:Name="ToDatePicker" Width="150" Margin="8,3,0,10" />
                <Button Content="Search" Click="Search_Click" />
                <Button Content="Clear filters" Click="Clear_Click" Style="{StaticResource SecondaryButtonStyle}" />
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextWrapping="Wrap" />
            </WrapPanel>
        </StackPanel>
        <DataGrid x:Name="InvoicesGrid" Grid.Row="1" SelectionChanged="InvoicesGrid_SelectionChanged" Margin="0,0,0,12">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Invoice" Binding="{Binding InvoiceNumber}" Width="*" />
                <DataGridTextColumn Header="Date / time" Binding="{Binding SoldAt, StringFormat=g}" Width="190" />
                <DataGridTextColumn Header="Payment" Binding="{Binding PaymentMethod}" Width="140" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120" />
                <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=C}" Width="140" />
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Invoice items" Style="{StaticResource SectionHeadingStyle}" VerticalAlignment="Center" />
            <Button Content="Export PDF" Click="ExportPdf_Click" Margin="16,0,4,0" />
            <Button Content="Print" Click="Print_Click" Style="{StaticResource SecondaryButtonStyle}" />
        </StackPanel>
        <DataGrid x:Name="ItemsGrid" Grid.Row="3">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Medicine" Binding="{Binding Medicine}" Width="*" />
                <DataGridTextColumn Header="Batch" Binding="{Binding Batch}" Width="*" />
                <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}" Width="110" />
                <DataGridTextColumn Header="Unit price" Binding="{Binding UnitPrice, StringFormat=C}" Width="140" />
                <DataGridTextColumn Header="Subtotal" Binding="{Binding LineTotal, StringFormat=C}" Width="140" />
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="4" Margin="0,12,0,0">
            <TextBlock x:Name="HistoryText" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" />
            <StackPanel x:Name="RefundPanel" Orientation="Horizontal" Margin="0,8,0,0">
                <TextBox x:Name="ReasonBox" Width="320" MaxLength="500" ToolTip="Reason for refund or void" />
                <Button Content="Refund sale" Click="Refund_Click" />
                <Button Content="Void sale" Click="Void_Click" Style="{StaticResource DangerButtonStyle}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
