<Window x:Class="MediStock.Desktop.Views.SupplierDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add supplier" Height="420" Width="440" MinHeight="390" MinWidth="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <StackPanel Margin="24">
        <TextBlock Text="Add supplier" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,12" />
        <TextBlock Text="Supplier name" /><TextBox x:Name="NameBox" />
        <TextBlock Text="Phone" /><TextBox x:Name="PhoneBox" />
        <TextBlock Text="Email (optional)" /><TextBox x:Name="EmailBox" />
        <TextBlock Text="Address (optional)" /><TextBox x:Name="AddressBox" />
        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Click="Cancel_Click" Style="{StaticResource SecondaryButtonStyle}" />
            <Button Content="Save supplier" Click="Save_Click" />
        </StackPanel>
    </StackPanel>
</Window>
