<UserControl Tag="Profile" x:Class="MediStock.Desktop.Views.ProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Profile" Style="{StaticResource PageHeadingStyle}" />
            <TextBlock Text="Email addresses cannot be edited."
                       Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,16" />
            <Border Style="{StaticResource CardBorderStyle}" Padding="18"
                    HorizontalAlignment="Stretch" MaxWidth="660">
                <StackPanel>
                    <TextBlock Text="Full name" /><TextBox x:Name="FullNameBox" />
                    <TextBlock Text="Email" /><TextBox x:Name="EmailBox" IsReadOnly="True" />
                    <TextBlock Text="Phone" /><TextBox x:Name="PhoneBox" />
                    <TextBlock Text="Pharmacy name" /><TextBox x:Name="PharmacyBox" />
                    <Separator Margin="0,4,0,12" />
                    <TextBlock Text="Current password (required to change password)" TextWrapping="Wrap" />
                    <PasswordBox x:Name="CurrentPasswordBox" Padding="9,7" Margin="0,3,0,10" />
                    <TextBlock Text="New password (optional; at least 10 characters)" TextWrapping="Wrap" />
                    <PasswordBox x:Name="NewPasswordBox" Padding="9,7" Margin="0,3,0,10" />
                    <TextBlock Text="Confirm new password" />
                    <PasswordBox x:Name="ConfirmPasswordBox" Padding="9,7" Margin="0,3,0,10" />
                    <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <Button Content="Save profile" Click="Save_Click" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
