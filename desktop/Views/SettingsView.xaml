<UserControl Tag="Settings" x:Class="MediStock.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
        <TextBlock Text="Settings" Style="{StaticResource PageHeadingStyle}" />
        <TextBlock Text="Set low-stock and expiry alerts."
                   Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,20" />
        <Border Style="{StaticResource CardBorderStyle}" Padding="18"
                HorizontalAlignment="Stretch" MaxWidth="660">
            <StackPanel>
                <TextBlock Text="Low-stock threshold (units)" />
                <TextBox x:Name="LowStockBox" />
                <TextBlock Text="Expiry warning period (days)" />
                <TextBox x:Name="ExpiryDaysBox" />
                <TextBlock Text="Desktop theme" />
                <ComboBox x:Name="ThemeBox" SelectedIndex="0">
                    <ComboBoxItem Content="Light" /><ComboBoxItem Content="Dark" />
                </ComboBox>
                <TextBlock x:Name="StatusText" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />
                <Button Content="Save settings" Click="Save_Click" HorizontalAlignment="Left" />
            </StackPanel>
        </Border>
    </StackPanel></ScrollViewer>
</UserControl>
