<UserControl x:Class="MediStock.Desktop.Views.SalesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Sales / POS" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="Stock is deducted when the sale is completed."
                       Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,14" />
            <Border Background="{DynamicResource SurfaceBrush}" Padding="12" Margin="0,0,0,12"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                <StackPanel Orientation="Horizontal">
                    <ComboBox x:Name="MedicineBox" Width="400" DisplayMemberPath="Display" />
                    <TextBox x:Name="QuantityBox" Width="95" Text="1" ToolTip="Quantity to add" />
                    <Button Content="Add to cart" Click="AddToCart_Click" />
                    <ComboBox x:Name="PaymentBox" Width="150" SelectedIndex="0">
                        <ComboBoxItem Content="Cash" /><ComboBoxItem Content="Card" />
                        <ComboBoxItem Content="Bank transfer" /><ComboBoxItem Content="Other" />
                    </ComboBox>
                </StackPanel>
            </Border>
        </StackPanel>
        <DataGrid x:Name="CartGrid" Grid.Row="1" SelectionChanged="CartGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Medicine" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="Available" Binding="{Binding Available}" Width="110" />
                <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}" Width="110" />
                <DataGridTextColumn Header="Unit price" Binding="{Binding UnitPrice, StringFormat=C}" Width="140" />
                <DataGridTextColumn Header="Subtotal" Binding="{Binding Subtotal, StringFormat=C}" Width="140" />
            </DataGrid.Columns>
        </DataGrid>
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="SetQuantityBox" Width="105" ToolTip="New quantity for selected cart item" />
                <Button Content="Set quantity" Click="SetQuantity_Click" />
                <Button Content="Remove item" Click="RemoveItem_Click"
                        Background="{DynamicResource AccentLightBrush}" Foreground="{DynamicResource TextBrush}" />
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Total:" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,7" />
                <TextBlock x:Name="TotalText" FontSize="22" FontWeight="Bold"
                           Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,18,7" />
                <Button Content="Complete sale" Click="CompleteSale_Click" Padding="18,10" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
