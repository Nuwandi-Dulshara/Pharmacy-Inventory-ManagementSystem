<UserControl x:Class="MediStock.Desktop.Views.CategoriesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Categories" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="Add, edit, and search medicine categories. In-use categories cannot be deleted."
                       Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,12" />
            <Border Background="{DynamicResource SurfaceBrush}" Padding="12" Margin="0,0,0,12"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="Category name" /><TextBox x:Name="NameBox" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                        <TextBlock Text="Description" /><TextBox x:Name="DescriptionBox" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                        <CheckBox x:Name="ActiveCheckBox" Content="Active" IsChecked="True" Margin="0,0,0,12" />
                    </StackPanel>
                </Grid>
            </Border>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="SaveButton" Content="Add category" Click="Save_Click" />
                <Button Content="Clear form" Click="Clear_Click" Background="{DynamicResource AccentLightBrush}"
                        Foreground="{DynamicResource TextBrush}" />
                <Button Content="Delete selected" Click="Delete_Click" Background="{DynamicResource DangerBrush}" />
                <TextBox x:Name="SearchBox" Width="260" ToolTip="Search categories" />
                <Button Content="Search" Click="Search_Click" />
            </StackPanel>
        </StackPanel>
        <DataGrid x:Name="CategoriesGrid" Grid.Row="1" SelectionChanged="CategoriesGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="220" />
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
                <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="100" />
                <DataGridTextColumn Header="Medicines" Binding="{Binding MedicineCount}" Width="110" />
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock x:Name="StatusText" Grid.Row="2" Margin="0,12,0,0" TextWrapping="Wrap" />
    </Grid>
</UserControl>
