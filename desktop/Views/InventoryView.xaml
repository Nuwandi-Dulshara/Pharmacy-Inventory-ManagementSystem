<UserControl x:Class="MediStock.Desktop.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Inventory" FontSize="28" FontWeight="SemiBold" />
            <TextBlock x:Name="PermissionText" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,12" />
            <Border x:Name="EditorPanel" Background="{DynamicResource SurfaceBrush}" Padding="14"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="Medicine" />
                        <ComboBox x:Name="MedicineBox" DisplayMemberPath="Display" SelectionChanged="MedicineBox_SelectionChanged" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,12,0">
                        <TextBlock Text="Name" /><TextBox x:Name="NameBox" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,12,0">
                        <TextBlock Text="Generic name" /><TextBox x:Name="GenericBox" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="3" Margin="0,0,12,0">
                        <TextBlock Text="Brand" /><TextBox x:Name="BrandBox" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="4">
                        <TextBlock Text="Selling price" /><TextBox x:Name="SellingPriceBox" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="Supplier" /><ComboBox x:Name="SupplierBox" DisplayMemberPath="Name" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,12,0">
                        <TextBlock Text="Batch number" /><TextBox x:Name="BatchNumberBox" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,12,0">
                        <TextBlock Text="Quantity received" /><TextBox x:Name="QuantityBox" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="3" Margin="0,0,12,0">
                        <TextBlock Text="Purchase price / unit" /><TextBox x:Name="PurchasePriceBox" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="4">
                        <TextBlock Text="Expiry date" /><DatePicker x:Name="ExpiryPicker" Margin="0,3,0,10" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5" Orientation="Horizontal">
                        <Button Content="Save medicine and stock" Click="SaveStock_Click" />
                        <Button Content="Add supplier" Click="AddSupplier_Click"
                                Background="{DynamicResource AccentLightBrush}" Foreground="{DynamicResource TextBrush}" />
                        <TextBlock x:Name="MessageText" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>
            <Border x:Name="AdjustmentPanel" Background="{DynamicResource SurfaceBrush}" Padding="12" Margin="0,0,0,12"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Stock adjustment for selected batch:" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBox x:Name="AdjustmentBox" Width="110" ToolTip="Enter a positive or negative quantity" />
                    <TextBox x:Name="AdjustmentReasonBox" Width="260" ToolTip="Reason for the adjustment" />
                    <Button Content="Apply adjustment" Click="ApplyAdjustment_Click" />
                    <TextBlock x:Name="AdjustmentMessage" VerticalAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
        <DataGrid x:Name="InventoryGrid" Grid.Row="1" SelectionChanged="InventoryGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Medicine" Binding="{Binding Medicine}" Width="*" />
                <DataGridTextColumn Header="Batch" Binding="{Binding Batch}" Width="*" />
                <DataGridTextColumn Header="Supplier" Binding="{Binding Supplier}" Width="*" />
                <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}" Width="95" />
                <DataGridTextColumn Header="Selling price" Binding="{Binding SellingPrice, StringFormat=C}" Width="130" />
                <DataGridTextColumn Header="Expiry" Binding="{Binding Expiry, StringFormat=d}" Width="130" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
