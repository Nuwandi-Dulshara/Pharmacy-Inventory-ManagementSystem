<UserControl x:Class="MediStock.Desktop.Views.ExpiryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Expiry management" FontSize="28" FontWeight="SemiBold" />
            <TextBlock x:Name="WarningText" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,12" />
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="SearchBox" Width="280" ToolTip="Search medicine name or batch number" />
                <ComboBox x:Name="FilterBox" Width="160" SelectedIndex="0">
                    <ComboBoxItem Content="All batches" />
                    <ComboBoxItem Content="Expired" />
                    <ComboBoxItem Content="Expiring soon" />
                    <ComboBoxItem Content="Usable" />
                </ComboBox>
                <Button Content="Apply filters" Click="ApplyFilters_Click" />
                <Button x:Name="DeleteButton" Content="Delete empty batch"
                        Click="DeleteBatch_Click" Background="{DynamicResource DangerBrush}" />
            </StackPanel>
        </StackPanel>
        <DataGrid x:Name="BatchesGrid" Grid.Row="1" SelectionChanged="BatchesGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Medicine" Binding="{Binding Medicine}" Width="*" />
                <DataGridTextColumn Header="Batch" Binding="{Binding BatchNumber}" Width="*" />
                <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}" Width="110" />
                <DataGridTextColumn Header="Expiry" Binding="{Binding ExpiryDate, StringFormat=d}" Width="150" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="150" />
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock x:Name="StatusText" Grid.Row="2" Margin="0,12,0,0" TextWrapping="Wrap" />
    </Grid>
</UserControl>
