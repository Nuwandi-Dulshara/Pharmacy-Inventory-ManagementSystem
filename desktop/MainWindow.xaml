<Window x:Class="MediStock.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MediStock Desktop" Height="760" Width="1180"
        MinHeight="620" MinWidth="960" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="16">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="MediStock" FontSize="24" FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}" Margin="2,6,0,0" />
                    <TextBlock x:Name="UserLabel" TextWrapping="Wrap" FontSize="12"
                               Foreground="{DynamicResource MutedBrush}" Margin="2,2,0,18" />
                    <Button Content="Dashboard" Click="Dashboard_Click" HorizontalContentAlignment="Left" />
                    <Button Content="Inventory" Click="Inventory_Click" HorizontalContentAlignment="Left" />
                    <Button Content="Sales / POS" Click="Sales_Click" HorizontalContentAlignment="Left" />
                    <Button Content="Invoices" Click="Invoices_Click" HorizontalContentAlignment="Left" />
                    <Button Content="Expiry management" Click="Expiry_Click" HorizontalContentAlignment="Left" />
                    <Button Content="Demand prediction" Click="Predictions_Click" HorizontalContentAlignment="Left" />
                    <Button Content="Reports" Click="Reports_Click" HorizontalContentAlignment="Left" />
                    <Button x:Name="CategoriesButton" Content="Categories" Click="Categories_Click"
                            HorizontalContentAlignment="Left" />
                    <Button Content="Profile" Click="Profile_Click" HorizontalContentAlignment="Left" />
                    <Button x:Name="SettingsButton" Content="Settings" Click="Settings_Click"
                            HorizontalContentAlignment="Left" />
                </StackPanel>
                <Button DockPanel.Dock="Bottom" Content="Sign out" Click="SignOut_Click"
                        HorizontalContentAlignment="Left" Background="{DynamicResource AccentLightBrush}"
                        Foreground="{DynamicResource TextBrush}" />
            </DockPanel>
        </Border>
        <Grid Grid.Column="1" Margin="24">
            <ContentControl x:Name="PageHost" />
        </Grid>
    </Grid>
</Window>
