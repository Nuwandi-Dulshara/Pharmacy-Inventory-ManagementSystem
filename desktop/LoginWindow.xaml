<Window x:Class="MediStock.Desktop.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MediStock — Sign in" Height="520" Width="440"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Background="{DynamicResource CanvasBrush}">
        <Border Width="350" Padding="30" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="MediStock" FontSize="30" FontWeight="Bold"
                           Foreground="{DynamicResource AccentBrush}" />
                <TextBlock Text="Pharmacy inventory desktop" Margin="0,3,0,22"
                           Foreground="{DynamicResource MutedBrush}" />
                <TextBlock Text="Email" />
                <TextBox x:Name="EmailBox" />
                <TextBlock Text="Password" />
                <PasswordBox x:Name="PasswordBox" Padding="9,7" Margin="0,3,0,10"
                             BorderBrush="{DynamicResource BorderBrush}" />
                <CheckBox x:Name="RememberCheckBox" Content="Remember email" Margin="0,0,0,14" />
                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}"
                           TextWrapping="Wrap" Margin="0,0,0,8" />
                <Button Content="Sign in" Click="SignIn_Click" Height="40" />
                <TextBlock Text="Use an existing MediStock account. Accounts are shared with the web application."
                           TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                           Margin="0,8,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
