<Window x:Class="MediStock.Desktop.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MediStock — Sign in" Height="700" Width="520"
        MinHeight="520" MinWidth="420" WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">
    <Grid Background="{DynamicResource HeroBrush}" TextElement.Foreground="{DynamicResource TextBrush}">
        <Ellipse Width="360" Height="360" Fill="#197A56" Opacity="0.4" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-120,-140,0,0" IsHitTestVisible="False" />
        <Ellipse Width="320" Height="320" Stroke="#76C596" StrokeThickness="40" Opacity="0.12" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-150,-100" IsHitTestVisible="False" />
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch">
        <Border Style="{StaticResource CardBorderStyle}" MaxWidth="420" Margin="28" Padding="30"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <Border Background="{DynamicResource AccentLightBrush}" CornerRadius="12" Padding="12" Margin="0,0,0,20">
                    <Viewbox Height="100" Stretch="Uniform" AutomationProperties.Name="Pharmacy illustration">
                        <Canvas Width="280" Height="100">
                            <Ellipse Canvas.Left="25" Canvas.Top="3" Width="90" Height="90" Fill="#B5DEC1" />
                            <Rectangle Canvas.Left="43" Canvas.Top="34" Width="55" Height="19" RadiusX="5" RadiusY="5" Fill="#08784F" />
                            <Rectangle Canvas.Left="61" Canvas.Top="16" Width="19" Height="55" RadiusX="5" RadiusY="5" Fill="#08784F" />
                            <Rectangle Canvas.Left="136" Canvas.Top="23" Width="64" Height="72" RadiusX="13" RadiusY="13" Fill="#FAFFF9" />
                            <Rectangle Canvas.Left="143" Canvas.Top="12" Width="50" Height="21" RadiusX="5" RadiusY="5" Fill="#07583D" />
                            <Rectangle Canvas.Left="136" Canvas.Top="49" Width="64" Height="27" Fill="#EBC66D" />
                            <Rectangle Canvas.Left="218" Canvas.Top="43" Width="34" Height="52" RadiusX="8" RadiusY="8" Fill="#0B8F5F" />
                            <Rectangle Canvas.Left="223" Canvas.Top="34" Width="24" Height="13" RadiusX="3" RadiusY="3" Fill="#07583D" />
                            <Rectangle Canvas.Left="218" Canvas.Top="62" Width="34" Height="18" Fill="#BFE8CC" />
                        </Canvas>
                    </Viewbox>
                </Border>
                <TextBlock Text="MediStock" FontSize="26" FontWeight="Bold"
                           Foreground="{DynamicResource AccentBrush}" />
                <TextBlock Text="Pharmacy inventory desktop" Margin="0,3,0,22"
                           Foreground="{DynamicResource MutedBrush}" />
                <TextBlock Text="Email" />
                <TextBox x:Name="EmailBox" />
                <TextBlock Text="Password" />
                <PasswordBox x:Name="PasswordBox" Padding="9,7" Margin="0,3,0,10"
                             BorderBrush="{DynamicResource BorderBrush}" />
                <CheckBox x:Name="RememberCheckBox" Content="Remember email" Margin="0,0,0,14" />
                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}"
                           TextWrapping="Wrap" Margin="0,0,0,8" />
                <Button Content="Sign in" Click="SignIn_Click" Height="40" />
                <TextBlock Text="Use your MediStock account. This app shares data with the web application."
                           TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0" />
            </StackPanel>
        </Border>
        </ScrollViewer>
    </Grid>
</Window>
