@page
@model MediStock.Pages.Categories.IndexModel
@{ ViewData["Title"] = "Categories"; }
<section class="medicine-page wrap">
  <div class="page-heading"><div><span class="section-kicker">CATALOGUE</span><h1>Categories</h1><p>Organize medicines by category.</p></div><a class="button button-primary" asp-page="Create">＋ Add category</a></div>
  @if (Model.StatusMessage is not null) { <div class="medicine-message">@Model.StatusMessage</div> }
  @if (Model.ErrorMessage is not null) { <div class="medicine-message medicine-message-error">@Model.ErrorMessage</div> }
  <section class="panel medicine-panel">
    <form method="get" class="medicine-search"><input name="Search" value="@Model.Search" placeholder="Search categories" /><button class="button button-outline">Search</button></form>
    <div class="table-wrap medicine-table-wrap"><table class="medicine-table"><thead><tr><th>CATEGORY</th><th>DESCRIPTION</th><th>STATUS</th><th>ACTIONS</th></tr></thead><tbody>
    @foreach (var item in Model.Items) { <tr><td class="medicine-name">@item.Name</td><td>@(item.Description ?? "—")</td><td><span class="medicine-status @(item.IsActive ? "status-active" : "status-inactive")">@(item.IsActive ? "Active" : "Inactive")</span></td><td><div class="medicine-row-actions"><a asp-page="Edit" asp-route-id="@item.Id">Edit</a><form method="post" asp-page-handler="Delete" asp-route-id="@item.Id" onsubmit="return confirm('Delete this category?');"><button class="delete-link">Delete</button></form></div></td></tr> }
    </tbody></table></div>
  </section>
</section>
