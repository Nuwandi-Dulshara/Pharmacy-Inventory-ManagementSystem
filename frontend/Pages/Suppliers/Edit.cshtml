@model MediStock.Pages.Suppliers.EditModel
@{ViewData["Title"]="Edit supplier";}
<section class="medicine-page wrap"><div class="page-heading"><div><a class="back-link" asp-page="Details" asp-route-id="@Model.Id">← Supplier details</a><h1>Edit supplier</h1></div></div><form method="post" class="panel medicine-form"><input type="hidden" asp-for="Id"/><div class="medicine-form-grid"><div class="field"><label asp-for="Input.Name">Supplier name *</label><input asp-for="Input.Name"/></div><div class="field"><label asp-for="Input.ContactPerson">Contact person</label><input asp-for="Input.ContactPerson"/></div><div class="field"><label asp-for="Input.Phone">Phone *</label><input asp-for="Input.Phone"/></div><div class="field"><label asp-for="Input.Email">Email</label><input asp-for="Input.Email"/></div><div class="field medicine-description-field"><label asp-for="Input.Address">Address</label><textarea asp-for="Input.Address" rows="3"></textarea></div></div><div class="medicine-form-actions"><a class="button button-outline" asp-page="Details" asp-route-id="@Model.Id">Cancel</a><button class="button button-primary">Save changes</button></div></form></section>
