@page
@model MediStock.Pages.Expiry.IndexModel
@{ViewData["Title"]="Expiry management";}
<section class="medicine-page wrap"><div class="page-heading"><div><span class="section-kicker">QUALITY CONTROL</span><h1>Expiry management</h1><p>Batches expiring within @Model.ExpiryWarningDays days are flagged for review.</p></div></div><section class="panel medicine-panel"><form method="get" class="medicine-search"><input name="Search" value="@Model.Search" placeholder="Search medicine"/><select name="Filter"><option value="">All batches</option><option value="soon" selected="@(Model.Filter=="soon")">Expiring soon</option><option value="expired" selected="@(Model.Filter=="expired")">Expired</option></select><button class="button button-outline">Filter</button></form><div class="table-wrap"><table class="medicine-table"><thead><tr><th>MEDICINE</th><th>BATCH</th><th>QUANTITY</th><th>EXPIRY</th><th>STATUS</th><th>ACTIONS</th></tr></thead><tbody>@foreach(var x in Model.Items){<tr><td>@x.Medicine</td><td>@x.BatchNumber</td><td>@x.Quantity</td><td>@x.ExpiryDate.ToString("dd MMM yyyy")</td><td><span class="medicine-status @(x.Status=="Expired"?"status-inactive":"status-active")">@x.Status</span></td><td><a asp-page="/Stock/Details" asp-route-id="@x.Id">Open batch</a></td></tr>}</tbody></table></div></section></section>
