@page
@model MediStock.Pages.Stock.DetailsModel
@{ViewData["Title"]="Stock batch details";}
<section class="medicine-page wrap"><div class="page-heading"><div><a class="back-link" asp-page="Index">← Stock</a><h1>Batch @Model.Batch?.BatchNumber</h1></div><a class="button button-primary" asp-page="Edit" asp-route-id="@Model.Batch?.Id">Edit batch</a></div>
<div class="medicine-details-grid"><section class="panel medicine-detail-panel"><dl class="medicine-info-list"><div><dt>Medicine</dt><dd>@Model.Batch?.Medicine.Name</dd></div><div><dt>Supplier</dt><dd>@Model.Batch?.Supplier.Name</dd></div><div><dt>Purchase price</dt><dd>LKR @Model.Batch?.PurchasePrice.ToString("N2")</dd></div><div><dt>Expiry date</dt><dd>@Model.Batch?.ExpiryDate.ToString("dd MMM yyyy")</dd></div><div><dt>Usable stock across batches</dt><dd>@Model.MedicineAvailableQuantity units (low stock at @Model.LowStockQuantity)</dd></div></dl></section><section class="panel medicine-stock-summary"><span class="section-kicker">BATCH QUANTITY</span><strong>@Model.Batch?.Quantity.ToString("N0")</strong><span>@Model.Status</span>@if(Model.MedicineAvailableQuantity<=Model.LowStockQuantity){<span class="medicine-status status-inactive">Low stock</span>}</section></div></section>
