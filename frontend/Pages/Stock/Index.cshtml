@page
@model MediStock.Pages.Stock.IndexModel
@{ViewData["Title"]="Stock management";}
<section class="medicine-page wrap"><div class="page-heading"><div><span class="section-kicker">INVENTORY</span><h1>Stock management</h1><p>Track batches, quantities, and expiry dates.</p></div><a class="button button-primary" asp-page="Create">＋ Add stock</a></div>
@if(Model.StatusMessage is not null){<div class="medicine-message">@Model.StatusMessage</div>}
<section class="panel medicine-panel"><form method="get" class="medicine-search"><input name="Search" value="@Model.Search" placeholder="Search medicine or batch"/><select name="Status" class="filter-select"><option value="">All statuses</option><option value="usable" selected="@(Model.Status=="usable")">Usable</option><option value="expiring" selected="@(Model.Status=="expiring")">Expiring soon</option><option value="expired" selected="@(Model.Status=="expired")">Expired</option></select><button class="button button-outline">Filter</button></form><div class="table-wrap medicine-table-wrap"><table class="medicine-table"><thead><tr><th>MEDICINE</th><th>BATCH</th><th class="align-right">QUANTITY</th><th>EXPIRY</th><th>SUPPLIER</th><th>STATUS</th><th>ACTIONS</th></tr></thead><tbody>@foreach(var x in Model.Items){<tr><td class="medicine-name">@x.Medicine</td><td>@x.BatchNumber</td><td class="align-right">@x.Quantity</td><td>@x.ExpiryDate.ToString("dd MMM yyyy")</td><td>@x.Supplier</td><td><span class="medicine-status @(x.Status=="Expired"?"status-inactive":"status-active")">@x.Status</span></td><td><div class="medicine-row-actions"><a asp-page="Details" asp-route-id="@x.Id">View</a><a asp-page="Edit" asp-route-id="@x.Id">Edit</a><form method="post" asp-page-handler="Delete" asp-route-id="@x.Id" onsubmit="return confirm('Delete this unused stock batch?');"><button class="delete-link">Delete</button></form></div></td></tr>}</tbody></table></div></section></section>
