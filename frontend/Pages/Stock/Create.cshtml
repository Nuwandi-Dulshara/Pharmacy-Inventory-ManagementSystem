@page
@model MediStock.Pages.Stock.CreateModel
@{ViewData["Title"]="Add stock";}
<section class="medicine-page wrap"><div class="page-heading"><div><a class="back-link" asp-page="Index">← Stock</a><h1>Add stock batch</h1></div></div><form method="post" class="panel medicine-form"><div asp-validation-summary="ModelOnly" class="validation-summary"></div><div class="medicine-form-grid">
<div class="field"><label asp-for="Input.MedicineId">Medicine *</label><select asp-for="Input.MedicineId" asp-items="Model.Medicines"><option value="">Select medicine</option></select></div><div class="field"><label asp-for="Input.SupplierId">Supplier *</label><select asp-for="Input.SupplierId" asp-items="Model.Suppliers"><option value="">Select supplier</option></select></div><div class="field"><label asp-for="Input.BatchNumber">Batch number *</label><input asp-for="Input.BatchNumber"/></div><div class="field"><label asp-for="Input.Quantity">Quantity *</label><input asp-for="Input.Quantity" type="number" min="1"/></div><div class="field"><label asp-for="Input.PurchasePrice">Purchase price (LKR)</label><input asp-for="Input.PurchasePrice" type="number" min="0" step=".01"/></div><div class="field"><label asp-for="Input.ExpiryDate">Expiry date *</label><input asp-for="Input.ExpiryDate" type="date"/></div></div><div class="medicine-form-actions"><a class="button button-outline" asp-page="Index">Cancel</a><button class="button button-primary">Save stock</button></div></form></section>
