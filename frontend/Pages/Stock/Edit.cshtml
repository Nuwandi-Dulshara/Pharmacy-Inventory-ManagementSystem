@page
@model MediStock.Pages.Stock.EditModel
@{ViewData["Title"]="Edit stock batch";}
<section class="medicine-page wrap"><div class="page-heading"><div><a class="back-link" asp-page="Details" asp-route-id="@Model.Id">← Stock batch</a><h1>Edit stock batch</h1></div></div><form method="post" class="panel medicine-form"><input type="hidden" asp-for="Id"/><div asp-validation-summary="ModelOnly" class="validation-summary"></div><div class="medicine-form-grid"><div class="field"><label>Medicine</label><input value="@Model.MedicineName" readonly/></div><div class="field"><label>Supplier</label><input value="@Model.SupplierName" readonly/></div><div class="field"><label asp-for="Input.BatchNumber">Batch number</label><input asp-for="Input.BatchNumber"/></div><div class="field"><label asp-for="Input.Quantity">Quantity</label><input asp-for="Input.Quantity" type="number" min="0"/></div><div class="field"><label asp-for="Input.PurchasePrice">Purchase price</label><input asp-for="Input.PurchasePrice" type="number" step=".01"/></div><div class="field"><label asp-for="Input.ExpiryDate">Expiry date</label><input asp-for="Input.ExpiryDate" type="date"/></div><div class="field medicine-description-field"><label asp-for="Input.Reason">Quantity correction reason</label><textarea asp-for="Input.Reason" rows="2" placeholder="Required only when quantity changes"></textarea></div></div><div class="medicine-form-actions"><a class="button button-outline" asp-page="Details" asp-route-id="@Model.Id">Cancel</a><button class="button button-primary">Save changes</button></div></form></section>
