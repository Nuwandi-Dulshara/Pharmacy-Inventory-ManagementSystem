@page
@model MediStock.Pages.Settings.IndexModel
@{ViewData["Title"]="Settings";}
<section class="medicine-page wrap"><div class="page-heading"><div><span class="section-kicker">SYSTEM</span><h1>Settings</h1></div></div>@if(Model.StatusMessage is not null){<div class="medicine-message">@Model.StatusMessage</div>}<form method="post" class="panel medicine-form"><div asp-validation-summary="All" class="validation-summary"></div><div class="medicine-form-grid"><div class="field"><label asp-for="Input.PharmacyName">Pharmacy name</label><input asp-for="Input.PharmacyName"/></div><div class="field"><label asp-for="Input.PharmacyAddress">Pharmacy address</label><input asp-for="Input.PharmacyAddress"/></div><div class="field"><label asp-for="Input.ContactNumber">Contact number</label><input asp-for="Input.ContactNumber"/></div><div class="field"><label asp-for="Input.Currency">Currency</label><input asp-for="Input.Currency"/></div><div class="field"><label asp-for="Input.LowStockQuantity">Low stock alert quantity</label><input asp-for="Input.LowStockQuantity" type="number" min="0"/></div><div class="field"><label asp-for="Input.ExpiryWarningDays">Expiry warning period</label><input asp-for="Input.ExpiryWarningDays" type="number" min="1"/></div><div class="field"><label asp-for="Input.Theme">Theme</label><select asp-for="Input.Theme"><option>Light</option><option>Dark</option></select></div></div><div class="medicine-form-actions"><button class="button button-primary" asp-page-handler="Save">Save settings</button></div></form><section class="panel medicine-batches-panel"><div class="panel-heading"><h2>Database backup and restore</h2></div><form method="post" asp-page-handler="Backup"><button class="button button-outline">Create backup</button></form><form method="post" asp-page-handler="Restore" enctype="multipart/form-data"><input type="file" name="BackupFile" accept=".db,.sqlite"/><button class="button button-outline">Restore backup</button></form></section></section>
