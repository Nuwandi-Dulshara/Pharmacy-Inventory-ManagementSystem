@page
@model MediStock.Pages.Reports.IndexModel
@{ViewData["Title"]="Reports";}
<section class="medicine-page wrap"><div class="page-heading"><div><span class="section-kicker">ANALYSIS</span><h1>Reports</h1></div></div>
@if(Model.ErrorMessage is not null){<div class="medicine-message medicine-message-error">@Model.ErrorMessage</div>}
<section class="panel medicine-form"><form method="get" class="medicine-form-grid"><div class="field"><label>Report type</label><select name="ReportType"><option value="Sales" selected="@(Model.ReportType=="Sales")">Sales report</option><option value="Stock" selected="@(Model.ReportType=="Stock")">Stock report</option><option value="Expiry" selected="@(Model.ReportType=="Expiry")">Expiry report</option><option value="Supplier" selected="@(Model.ReportType=="Supplier")">Supplier report</option></select></div><div class="field"><label>From date</label><input name="From" type="date" value="@Model.From.ToString("yyyy-MM-dd")"/></div><div class="field"><label>To date</label><input name="To" type="date" value="@Model.To.ToString("yyyy-MM-dd")"/></div><div class="medicine-form-actions" style="grid-column:1/-1"><button class="button button-primary">Generate report</button><button class="button button-outline" asp-page-handler="Csv" formmethod="post">Export CSV</button><button class="button button-outline" asp-page-handler="Pdf" formmethod="post">Export PDF</button></div></form></section>
<section class="panel medicine-batches-panel"><div class="table-wrap"><table class="medicine-table"><thead><tr>@foreach(var h in Model.Headers){<th>@h</th>}</tr></thead><tbody>@foreach(var row in Model.Rows){<tr>@foreach(var value in row){<td>@value</td>}</tr>}</tbody></table></div></section></section>
