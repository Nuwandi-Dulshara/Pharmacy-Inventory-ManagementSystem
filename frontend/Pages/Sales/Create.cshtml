@page
@model MediStock.Pages.Sales.CreateModel
@{ViewData["Title"]="New sale";}
<section class="medicine-page wrap"><div class="page-heading"><div><a class="back-link" asp-page="Index">← Sales</a><h1>New sale</h1><p>Only available, non-expired batches can be sold.</p></div></div><form method="post" class="panel medicine-form"><div asp-validation-summary="ModelOnly" class="validation-summary"></div><div class="medicine-form-grid"><div class="field"><label asp-for="Input.MedicineId">Medicine *</label><select asp-for="Input.MedicineId" asp-items="Model.Medicines"><option value="">Select medicine</option></select></div><div class="field"><label asp-for="Input.Quantity">Quantity *</label><input asp-for="Input.Quantity" type="number" min="1"/></div><div class="field"><label asp-for="Input.PaymentMethod">Payment method *</label><select asp-for="Input.PaymentMethod"><option>Cash</option><option>Card</option></select></div></div><div class="medicine-form-actions"><a class="button button-outline" asp-page="Index">Cancel</a><button class="button button-primary">Complete sale</button></div></form></section>
