@page
@model MediStock.Pages.Sales.CreateModel
@{ViewData["Title"]="New sale";}
<section class="medicine-page wrap">
    <div class="page-heading"><div><a class="back-link" asp-page="Index">← Sales</a><h1>New sale</h1><p>Only available, non-expired batches can be sold.</p></div></div>
    <form method="post" class="panel medicine-form" data-pos-cart>
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
        <div class="field"><label for="medicine-search">Search medicines</label><input id="medicine-search" type="search" autocomplete="off" placeholder="Type a medicine name"/></div>
        <div class="pos-catalog" data-pos-catalog>
            @foreach(var medicine in Model.Medicines)
            {
                <div class="pos-catalog-item" data-pos-medicine data-id="@medicine.Id" data-name="@medicine.Name" data-price="@medicine.UnitPrice.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-stock="@medicine.AvailableQuantity">
                    <span><strong>@medicine.Name</strong><small>@medicine.AvailableQuantity available · @medicine.UnitPrice.ToString("N2") each</small></span>
                    <button class="button button-outline" type="button" data-pos-add>Add</button>
                </div>
            }
        </div>
        <h2>Cart</h2>
        <div class="table-wrap">
            <table class="medicine-table">
                <thead><tr><th>MEDICINE</th><th>QUANTITY</th><th>UNIT PRICE</th><th>SUBTOTAL</th><th></th></tr></thead>
                <tbody data-pos-items><tr data-pos-empty><td colspan="5">No medicines added.</td></tr></tbody>
            </table>
        </div>
        <template data-pos-row-template>
            <tr data-pos-row>
                <td><span data-pos-name></span><input data-pos-medicine-id type="hidden"/></td>
                <td><input data-pos-quantity type="number" min="1" value="1"/></td>
                <td data-pos-price></td>
                <td data-pos-subtotal></td>
                <td><button class="delete-link" type="button" data-pos-remove>Remove</button></td>
            </tr>
        </template>
        <div class="medicine-form-grid">
            <div class="field"><label asp-for="Input.PaymentMethod">Payment method</label><select asp-for="Input.PaymentMethod"><option>Cash</option><option>Card</option></select></div>
            <div class="pos-total"><strong>Total</strong><strong data-pos-total>0.00</strong></div>
        </div>
        <div class="medicine-form-actions"><a class="button button-outline" asp-page="Index">Cancel</a><button class="button button-primary">Complete sale</button></div>
    </form>
</section>
