@page
@model MediStock.Pages.Predictions.IndexModel
@{ViewData["Title"]="AI stock prediction";}
<section class="medicine-page wrap"><div class="page-heading"><div><span class="section-kicker">AI STOCK PLANNING</span><h1>Demand prediction</h1><p>Estimate future demand using historical completed sales. These are estimates only.</p></div></div><section class="panel medicine-form"><form method="get" class="medicine-form-grid"><div class="field"><label>Medicine</label><select name="MedicineId" asp-items="Model.Medicines"></select></div><div class="field"><label>Forecast period</label><select name="Days"><option value="7" selected="@(Model.Days==7)">Next 7 days</option><option value="30" selected="@(Model.Days==30)">Next 30 days</option></select></div><div class="medicine-form-actions" style="grid-column:1/-1"><button class="button button-primary">Predict demand</button></div></form></section>
@if(Model.PredictedQuantity.HasValue){<section class="panel medicine-batches-panel"><h2>Predicted demand: @Model.PredictedQuantity units</h2><p>Current stock: @Model.CurrentStock units</p><p><strong>@(Model.CurrentStock<Model.PredictedQuantity?"Possible stock shortage":"Stock level appears sufficient")</strong></p><small>Estimate based on recent sales history.</small></section>}</section>
