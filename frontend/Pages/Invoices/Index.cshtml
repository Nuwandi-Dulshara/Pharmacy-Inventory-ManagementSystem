@page
@model MediStock.Pages.Invoices.IndexModel
@{ViewData["Title"]="Invoices";}
<section class="medicine-page wrap"><div class="page-heading"><div><span class="section-kicker">DOCUMENTS</span><h1>Invoices</h1></div></div><section class="panel medicine-panel"><form method="get" class="medicine-search"><input name="Search" value="@Model.Search" placeholder="Search invoice number or date"/><button class="button button-outline">Search</button></form><div class="table-wrap"><table class="medicine-table"><thead><tr><th>INVOICE</th><th>DATE</th><th>TOTAL</th><th>PAYMENT</th><th>ACTIONS</th></tr></thead><tbody>@foreach(var x in Model.Items){<tr><td class="medicine-name">@x.InvoiceNumber</td><td>@x.Date.ToLocalTime().ToString("dd MMM yyyy")</td><td>LKR @x.Total.ToString("N2")</td><td>@x.PaymentMethod</td><td><div class="medicine-row-actions"><a asp-page="Details" asp-route-id="@x.Id">View</a><a asp-page="Details" asp-route-id="@x.Id" asp-fragment="print">Print</a></div></td></tr>}</tbody></table></div></section></section>
