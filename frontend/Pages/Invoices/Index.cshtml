@page
@model MediStock.Pages.Invoices.IndexModel
@{ViewData["Title"]="Invoices";}
<section class="medicine-page wrap"><div class="page-heading"><div><span class="section-kicker">DOCUMENTS</span><h1>Invoices</h1></div></div>
@if(Model.FilterError is not null){<div class="medicine-message medicine-message-error">@Model.FilterError</div>}
<section class="panel medicine-panel"><form method="get" class="medicine-search"><input name="Search" value="@Model.Search" placeholder="Search invoice number"/><label>On date <input name="SelectedDate" type="date" value="@Model.SelectedDate?.ToString("yyyy-MM-dd")"/></label><label>From <input name="FromDate" type="date" value="@Model.FromDate?.ToString("yyyy-MM-dd")"/></label><label>To <input name="ToDate" type="date" value="@Model.ToDate?.ToString("yyyy-MM-dd")"/></label><button class="button button-outline">Filter</button><a class="button button-outline" asp-page="Index">Clear filters</a></form><div class="table-wrap"><table class="medicine-table"><thead><tr><th>INVOICE</th><th>DATE</th><th>TOTAL</th><th>PAYMENT</th><th>STATUS</th><th>ACTIONS</th></tr></thead><tbody>@foreach(var x in Model.Items){<tr><td class="medicine-name">@x.InvoiceNumber</td><td>@x.Date.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td><td>LKR @x.Total.ToString("N2")</td><td>@x.PaymentMethod</td><td>@x.Status</td><td><div class="medicine-row-actions"><a asp-page="Details" asp-route-id="@x.Id">View</a><a asp-page="Details" asp-page-handler="Pdf" asp-route-id="@x.Id">PDF</a></div></td></tr>}</tbody></table></div></section></section>
