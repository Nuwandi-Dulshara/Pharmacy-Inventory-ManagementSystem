@page
@model MediStock.Pages.Invoices.DetailsModel
@{ViewData["Title"]="Invoice "+(Model.Sale?.InvoiceNumber??"");}
<section class="medicine-page wrap"><div class="page-heading"><div><a class="back-link" asp-page="Index">← Invoices</a><h1>Invoice @Model.Sale?.InvoiceNumber</h1></div><button id="print" class="button button-primary" type="button" onclick="window.print()">Print invoice</button></div>
<section id="invoice" class="panel medicine-detail-panel"><div class="panel-heading"><div><h2>@Model.PharmacyName</h2><p>@Model.PharmacyAddress</p></div><div><strong>@Model.Sale?.InvoiceNumber</strong><p>@Model.Sale?.SoldAtUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</p></div></div><div class="table-wrap"><table class="medicine-table"><thead><tr><th>MEDICINE</th><th>BATCH</th><th class="align-right">QTY</th><th class="align-right">UNIT PRICE</th><th class="align-right">LINE TOTAL</th></tr></thead><tbody>@foreach(var x in Model.Items){<tr><td>@x.Medicine</td><td>@x.Batch</td><td class="align-right">@x.Quantity</td><td class="align-right">LKR @x.UnitPrice.ToString("N2")</td><td class="align-right">LKR @x.LineTotal.ToString("N2")</td></tr>}</tbody></table></div><div class="medicine-form-actions"><strong>Payment: @Model.Sale?.PaymentMethod</strong><strong>Total: LKR @Model.Sale?.TotalAmount.ToString("N2")</strong></div>
<form method="post" asp-page-handler="Void" asp-route-id="@Model.Sale?.Id" onsubmit="return confirm('Void this sale? Stock quantities will be restored.');"><input name="reason" placeholder="Void reason" required/><button class="button button-outline">Void / Refund</button></form></section></section>
