@page
@model MediStock.Pages.Invoices.DetailsModel
@{ViewData["Title"]="Invoice "+(Model.Sale?.InvoiceNumber??"");}
<section class="medicine-page wrap"><div class="page-heading"><div><a class="back-link" asp-page="Index">← Invoices</a><h1>Invoice @Model.Sale?.InvoiceNumber</h1></div><div class="dashboard-actions"><a class="button button-outline" asp-page-handler="Pdf" asp-route-id="@Model.Sale?.Id">Export PDF</a><button id="print" class="button button-primary" type="button" onclick="window.print()">Print invoice</button></div></div>
@if(TempData["StatusMessage"] is string statusMessage){<div class="medicine-message">@statusMessage</div>}
@if(TempData["ErrorMessage"] is string errorMessage){<div class="medicine-message medicine-message-error">@errorMessage</div>}
<section id="invoice" class="panel medicine-detail-panel"><div class="panel-heading"><div><h2>@Model.PharmacyName</h2><p>@Model.PharmacyAddress</p><p>@Model.PharmacyContact</p></div><div><strong>@Model.Sale?.InvoiceNumber</strong><p>@Model.Sale?.SoldAtUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</p><span class="medicine-status status-active">@Model.Sale?.Status</span></div></div><div class="table-wrap"><table class="medicine-table"><thead><tr><th>MEDICINE</th><th>BATCH</th><th class="align-right">QTY</th><th class="align-right">UNIT PRICE</th><th class="align-right">LINE TOTAL</th></tr></thead><tbody>@foreach(var x in Model.Items){<tr><td>@x.Medicine</td><td>@x.Batch</td><td class="align-right">@x.Quantity</td><td class="align-right">@Model.Currency @x.UnitPrice.ToString("N2")</td><td class="align-right">@Model.Currency @x.LineTotal.ToString("N2")</td></tr>}</tbody></table></div><div class="medicine-form-actions"><strong>Payment: @Model.Sale?.PaymentMethod</strong><strong>Total: @Model.Currency @Model.Sale?.TotalAmount.ToString("N2")</strong></div>
@if(Model.RefundHistory is not null){<div class="panel medicine-batches-panel"><h2>@Model.RefundHistory.Action history</h2><p>Reason: @Model.RefundHistory.Reason</p><p>Authorized by: @Model.RefundHistory.AuthorizedUser (@Model.RefundHistory.AuthorizedUserEmail)</p><p>Date: @Model.RefundHistory.CreatedUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</p><p>Amount: @Model.Currency @Model.RefundHistory.Amount.ToString("N2")</p></div>}
@if(User.IsInRole("Administrator") && Model.Sale?.Status == "Completed"){<form method="post" asp-page-handler="Refund" asp-route-id="@Model.Sale?.Id" onsubmit="return confirm('Refund this sale and restore its stock?');"><div class="field"><label for="refund-reason">Reason for refund</label><input id="refund-reason" name="reason" minlength="3" maxlength="500" required/></div><button class="button button-outline">Refund sale</button></form><form method="post" asp-page-handler="Void" asp-route-id="@Model.Sale?.Id" onsubmit="return confirm('Void this sale and restore its stock?');"><div class="field"><label for="void-reason">Reason for void</label><input id="void-reason" name="reason" minlength="3" maxlength="500" required/></div><button class="button button-outline">Void sale</button></form>}</section></section>
