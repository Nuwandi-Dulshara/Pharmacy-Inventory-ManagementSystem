@page
@model MediStock.Pages.Profile.EditModel
@{ViewData["Title"]="Update profile";}
<section class="medicine-page wrap"><div class="page-heading"><div><a class="back-link" asp-page="Index">← Profile</a><h1>Update profile</h1></div></div><form method="post" class="panel medicine-form"><div asp-validation-summary="ModelOnly" class="validation-summary"></div><div class="medicine-form-grid"><div class="field"><label asp-for="Input.FullName">Full name</label><input asp-for="Input.FullName"/></div><div class="field"><label asp-for="Input.PhoneNumber">Phone number</label><input asp-for="Input.PhoneNumber"/></div><div class="field"><label asp-for="Input.PharmacyName">Pharmacy name</label><input asp-for="Input.PharmacyName"/></div><div class="field medicine-description-field"><label asp-for="Input.CurrentPassword">Current password</label><input asp-for="Input.CurrentPassword" type="password" autocomplete="current-password"/></div><div class="field"><label asp-for="Input.NewPassword">New password</label><input asp-for="Input.NewPassword" type="password" autocomplete="new-password"/></div><div class="field"><label asp-for="Input.ConfirmPassword">Confirm password</label><input asp-for="Input.ConfirmPassword" type="password" autocomplete="new-password"/></div></div><div class="medicine-form-actions"><a class="button button-outline" asp-page="Index">Cancel</a><button class="button button-primary">Save changes</button></div></form></section>
