@page
@model MediStock.Pages.Profile.IndexModel
@{ViewData["Title"]="Profile";}
<section class="medicine-page wrap"><div class="page-heading"><div><h1>Profile</h1></div><a class="button button-primary" asp-page="Edit">Update profile</a></div>@if(Model.StatusMessage is not null){<div class="medicine-message">@Model.StatusMessage</div>}<section class="panel medicine-detail-panel"><dl class="medicine-info-list"><div><dt>Full name</dt><dd>@Model.Profile?.FullName</dd></div><div><dt>Email address</dt><dd>@Model.Profile?.Email</dd></div><div><dt>Phone number</dt><dd>@Model.Profile?.PhoneNumber</dd></div><div><dt>Pharmacy name</dt><dd>@Model.Profile?.PharmacyName</dd></div></dl></section></section>
